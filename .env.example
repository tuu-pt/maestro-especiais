# Copiar para .env (ou correr `make env`, que gera segredos aleatórios de desenvolvimento).
# Nunca versionar o .env. Nunca usar chaves pessoais.

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Redis
REDIS_PASSWORD=

# Armazenamento S3 (SeaweedFS em desenvolvimento)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# Portas no host (vazio = valor por omissão do docker-compose.yml)
DB_HOST_PORT=
REDIS_HOST_PORT=
S3_HOST_PORT=
BACKEND_HOST_PORT=
FRONTEND_HOST_PORT=

# LLM (SPEC 6.1). Chave de um projeto Google da TUU, nunca pessoal.
# Nomes de modelos só aqui, nunca no código.
# gemini (por omissão), groq (só para avaliação, [A CONFIRMAR] D5/D10) ou fake (sem rede)
LLM_PROVIDER=
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_MODEL_DRAFTING=
LLM_MODEL_EXTRACTION=
LLM_MODEL_EMBEDDING=
EMBEDDING_DIM=
# Alternativa quando o principal fica indisponível (5xx depois das repetições, ex.: 503 do Gemini).
# Ex.: groq com openai/gpt-oss-120b [A CONFIRMAR: D5, D10]. Vazio = sem alternativa.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL_DRAFTING=
LLM_FALLBACK_MODEL_EXTRACTION=
LLM_FALLBACK_RPM=
# Ritmo da quota gratuita: pedidos por minuto e por dia
LLM_RPM=
LLM_RPD=

# Perfis dos técnicos, cifrados em repouso (Fernet). make env gera uma chave de desenvolvimento.
PROFILE_ENCRYPTION_KEY=

# Exportação (Fase 6): segredo dos links assinados (HMAC) e token de serviço do TUU Maestro (D9).
# make env gera os dois; num .env existente: make env-update.
EXPORT_LINK_SECRET=
MAESTRO_SERVICE_TOKEN=
